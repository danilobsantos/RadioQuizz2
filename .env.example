# Configurações do Supabase para o Frontend (Vite)
# Encontradas no painel do Supabase: Project Settings -> API

# URL do projeto Supabase (ex.: https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon / publishable) do Supabase
# ATENÇÃO: Apenas chaves públicas (anon / publishable) devem ser expostas no frontend.
# NUNCA utilize a chave secreta (service_role) aqui.
VITE_SUPABASE_KEY=sua-chave-anon-ou-publishable-aqui

